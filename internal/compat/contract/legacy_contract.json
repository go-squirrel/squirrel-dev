  "databases": [
    {
      "program": "squ-apiserver",
      "logicalName": "main",
      "defaultPath": "./db/apiserver.db",
      "tables": ["migrations", "healths", "users", "servers", "configs", "applications", "deployments", "app_stores", "scripts", "script_results"],
      "migrations": ["1.0.0", "1.0.1"]
    },
    {
      "program": "squ-agent",
      "logicalName": "agent",
      "defaultPath": "./db/agent.db",
      "tables": ["migrations", "configs"],
      "migrations": ["1.0.0"]
    },
    {
      "program": "squ-agent",
      "logicalName": "application",
      "defaultPath": "./db/agent-app.db",
      "tables": ["migrations", "applications"],
      "migrations": ["1.0.0"]
    },
    {
      "program": "squ-agent",
      "logicalName": "monitor",
      "defaultPath": "./db/agent-monitor.db",
      "tables": ["migrations", "base_monitors", "disk_io_monitors", "disk_usage_monitors", "network_monitors"],
      "migrations": ["1.0.0"]
    },
    {
      "program": "squ-agent",
      "logicalName": "script-task",
      "defaultPath": "./db/agent-script-task.db",
      "tables": ["migrations", "script_execution_tasks"],
      "migrations": ["1.0.0"]
    }
  ],
  "asyncBehaviors": [
    {"program": "squ-agent", "name": "cron", "detail": "Starts after migrations and before the HTTP listener blocks."},
    {"program": "squ-agent", "name": "monitor-stats", "detail": "Collects CPU, memory, disk, IO and process statistics."},
    {"program": "squ-agent", "name": "script-result-report", "detail": "Retries reporting unreported script execution results to apiserver."},
    {"program": "squ-apiserver", "name": "deployment-status", "detail": "Receives deployment status callbacks from agents."},
    {"program": "squ-apiserver", "name": "terminal", "detail": "Proxies an authenticated WebSocket terminal over SSH."}
  ],
  "httpSamples": [
    {
      "service": "squ-apiserver",
      "method": "GET",
      "path": "/api/v1/health",
      "status": 200,
      "contentType": "application/json; charset=utf-8",
      "body": "{\"code\":0,\"message\":\"success\",\"data\":\"health\"}"
    },
    {
      "service": "squ-apiserver",
      "method": "POST",
      "path": "/api/v1/login",
      "status": 200,
      "contentType": "application/json; charset=utf-8",
      "body": "{\"code\":0,\"message\":\"success\",\"data\":{\"token\":\"<jwt>\"}}"
    },
    {
      "service": "squ-apiserver",
      "method": "HEAD",
      "path": "/",
      "status": 200,
      "contentType": "text/html; charset=utf-8",
      "body": ""
    }
  ],
  "knownGaps": [
    "The old apiserver cannot be built until the Vue dist directory is generated.",
    "Redis tests require loopback socket access.",
    "Kubernetes tests are not deterministic in the current environment.",
    "API request and response DTO field snapshots still need module-level characterization tests.",
    "Timing and retry semantics require black-box tests when the corresponding modules migrate."
  ]
}
