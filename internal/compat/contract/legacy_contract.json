{
  "schemaVersion": 1,
  "source": {
    "repository": "squirrel-dev-old",
    "commit": "1dd982f"
  },
  "services": [
    {
      "name": "squ-agent",
      "routes": [
        {"method": "GET", "path": "/api/v1/health", "auth": "none"},
        {"method": "GET", "path": "/api/v1/application", "auth": "none"},
        {"method": "GET", "path": "/api/v1/application/:id", "auth": "none"},
        {"method": "DELETE", "path": "/api/v1/application/:id", "auth": "none"},
        {"method": "POST", "path": "/api/v1/application", "auth": "none"},
        {"method": "POST", "path": "/api/v1/application/:id", "auth": "none"},
        {"method": "POST", "path": "/api/v1/application/start/:deployId", "auth": "none"},
        {"method": "POST", "path": "/api/v1/application/stop/:deployId", "auth": "none"},
        {"method": "POST", "path": "/api/v1/application/delete/:deployId", "auth": "none"},
        {"method": "GET", "path": "/api/v1/config", "auth": "none"},
        {"method": "GET", "path": "/api/v1/config/:id", "auth": "none"},
        {"method": "DELETE", "path": "/api/v1/config/:id", "auth": "none"},
        {"method": "POST", "path": "/api/v1/config", "auth": "none"},
        {"method": "GET", "path": "/api/v1/server/info", "auth": "none"},
        {"method": "GET", "path": "/api/v1/monitor/stats", "auth": "none"},
        {"method": "GET", "path": "/api/v1/monitor/stats/io/:device", "auth": "none"},
        {"method": "GET", "path": "/api/v1/monitor/stats/io/all", "auth": "none"},
        {"method": "GET", "path": "/api/v1/monitor/stats/net/:interface", "auth": "none"},
        {"method": "GET", "path": "/api/v1/monitor/stats/net/all", "auth": "none"},
        {"method": "GET", "path": "/api/v1/monitor/base", "auth": "none"},
        {"method": "GET", "path": "/api/v1/monitor/disk", "auth": "none"},
        {"method": "GET", "path": "/api/v1/monitor/disk-usage", "auth": "none"},
        {"method": "GET", "path": "/api/v1/monitor/net", "auth": "none"},
        {"method": "POST", "path": "/api/v1/script/execute", "auth": "none"}
      ]
    },
    {
      "name": "squ-apiserver",
      "routes": [
        {"method": "POST", "path": "/api/v1/login", "auth": "none"},
        {"method": "GET", "path": "/api/v1/ws/server/:id", "transport": "websocket", "auth": "message-token"},
        {"method": "GET", "path": "/api/v1/health", "auth": "none"},
        {"method": "GET", "path": "/api/v1/server", "auth": "none"},
        {"method": "GET", "path": "/api/v1/server/:id", "auth": "none"},
        {"method": "DELETE", "path": "/api/v1/server/:id", "auth": "none"},
        {"method": "POST", "path": "/api/v1/server", "auth": "none"},
        {"method": "POST", "path": "/api/v1/server/:id", "auth": "none"},
        {"method": "POST", "path": "/api/v1/server/check", "auth": "none"},
        {"method": "POST", "path": "/api/v1/ssh/test/:id", "auth": "none"},
        {"method": "GET", "path": "/api/v1/application", "auth": "none"},
        {"method": "GET", "path": "/api/v1/application/:id", "auth": "none"},
        {"method": "DELETE", "path": "/api/v1/application/:id", "auth": "none"},
        {"method": "POST", "path": "/api/v1/application", "auth": "none"},
        {"method": "POST", "path": "/api/v1/application/:id", "auth": "none"},
        {"method": "GET", "path": "/api/v1/deployment", "auth": "none"},
        {"method": "POST", "path": "/api/v1/deployment/:id", "auth": "none"},
        {"method": "POST", "path": "/api/v1/deployment/deploy/:id", "auth": "none"},
        {"method": "GET", "path": "/api/v1/deployment/:id/servers", "auth": "none"},
        {"method": "DELETE", "path": "/api/v1/deployment/deploy/:id", "auth": "none"},
        {"method": "POST", "path": "/api/v1/deployment/stop/:id", "auth": "none"},
        {"method": "POST", "path": "/api/v1/deployment/start/:id", "auth": "none"},
        {"method": "POST", "path": "/api/v1/deployment/redeploy/:id", "auth": "none"},
        {"method": "POST", "path": "/api/v1/deployment/report", "auth": "mtls-when-enabled"},
        {"method": "GET", "path": "/api/v1/config", "auth": "none"},
        {"method": "GET", "path": "/api/v1/config/:id", "auth": "none"},
        {"method": "DELETE", "path": "/api/v1/config/:id", "auth": "none"},
        {"method": "POST", "path": "/api/v1/config", "auth": "none"},
        {"method": "POST", "path": "/api/v1/config/:id", "auth": "none"},
        {"method": "GET", "path": "/api/v1/app-store", "auth": "none"},
        {"method": "GET", "path": "/api/v1/app-store/:id", "auth": "none"},
        {"method": "DELETE", "path": "/api/v1/app-store/:id", "auth": "none"},
        {"method": "POST", "path": "/api/v1/app-store", "auth": "none"},
        {"method": "POST", "path": "/api/v1/app-store/:id", "auth": "none"},
        {"method": "GET", "path": "/api/v1/scripts", "auth": "none"},
        {"method": "GET", "path": "/api/v1/scripts/:id", "auth": "none"},
        {"method": "DELETE", "path": "/api/v1/scripts/:id", "auth": "none"},
        {"method": "POST", "path": "/api/v1/scripts", "auth": "none"},
        {"method": "POST", "path": "/api/v1/scripts/:id", "auth": "none"},
        {"method": "POST", "path": "/api/v1/scripts/execute", "auth": "none"},
        {"method": "GET", "path": "/api/v1/scripts/:id/results", "auth": "none"},
        {"method": "POST", "path": "/api/v1/scripts/receive-result", "auth": "mtls-when-enabled"},
        {"method": "GET", "path": "/api/v1/monitor/stats/:serverId", "auth": "none"},
        {"method": "GET", "path": "/api/v1/monitor/stats/io/:serverId/:device", "auth": "none"},
        {"method": "GET", "path": "/api/v1/monitor/stats/io/:serverId/all", "auth": "none"},
        {"method": "GET", "path": "/api/v1/monitor/stats/net/:serverId/:interface", "auth": "none"},
        {"method": "GET", "path": "/api/v1/monitor/stats/net/:serverId/all", "auth": "none"},
        {"method": "GET", "path": "/api/v1/monitor/base/:serverId", "auth": "none"},
        {"method": "GET", "path": "/api/v1/monitor/disk/:serverId", "auth": "none"},
        {"method": "GET", "path": "/api/v1/monitor/disk-usage/:serverId", "auth": "none"},
        {"method": "GET", "path": "/api/v1/monitor/net/:serverId", "auth": "none"}
      ]
    }
  ],
  "cli": [
    {
      "program": "squ-agent",
      "defaultConfig": "config/agent.yaml",
      "versionOutputPrefix": "version:",
      "commands": [{"name": "version"}]
    },
    {
      "program": "squ-apiserver",
      "defaultConfig": "config/apiserver.yaml",
      "versionOutputPrefix": "version:",
      "commands": [{"name": "version"}]
    },
    {
      "program": "squctl",
      "defaultConfig": "config/squctl.yaml",
      "versionOutputPrefix": "version:",
      "commands": [
        {"name": "version"},
        {
          "name": "certs",
          "flags": [
            {"name": "output", "short": "o", "default": "./certs"},
            {"name": "only-ca", "default": false},
            {"name": "ca-cn", "default": "squirrel-ca"},
            {"name": "only-server", "default": false},
            {"name": "server-cn", "default": "squirrel-apiserver"},
            {"name": "server-hosts", "default": ["127.0.0.1", "localhost"]},
            {"name": "only-client", "default": false},
            {"name": "client-cn", "default": "squirrel-agent"},
            {"name": "expiry", "default": "87600h0m0s"},
            {"name": "key-size", "default": 2048},
            {"name": "overwrite", "default": false}
          ]
        }
      ]
    }
  ],
  "configs": [
    {
      "program": "squ-agent",
      "defaultFile": "config/agent.yaml",
      "requiredSections": ["server", "cache", "db", "log", "common", "apiserver"],
      "sqlitePaths": [
        "db.sqlite.agentFilePath",
        "db.sqlite.appFilePath",
        "db.sqlite.monitorFilePath",
        "db.sqlite.scriptTaskFilePath"
      ]
    },
    {
      "program": "squ-apiserver",
      "defaultFile": "config/apiserver.yaml",
      "requiredSections": ["server", "auth", "db", "log", "agent", "mtls"],
      "sqlitePaths": ["db.sqlite.filePath"]
    },
    {
      "program": "squctl",
      "defaultFile": "config/squctl.yaml",
      "requiredSections": []
    }
  ],
  "responses": {
    "envelope": ["code", "message", "data"],
    "common": [
      {"code": 0, "name": "CodeSuccess", "message": "success"},
      {"code": 41001, "name": "ErrCodeParameter", "message": "parameter error"},
      {"code": 41002, "name": "ErrUserOrPassword", "message": "user or password error"},
      {"code": 41003, "name": "ErrMissingAuthHeader", "message": "missing authorization header"},
      {"code": 41004, "name": "ErrInvalidAuthFormat", "message": "invalid authorization header format"},
